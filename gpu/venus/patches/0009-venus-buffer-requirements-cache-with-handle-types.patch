Subject: venus: the buffer requirements cache takes external memory handle types

A buffer whose create info carries VkExternalMemoryBufferCreateInfo skipped the memory requirements cache, so each
vkCreateBuffer was two synchronous round trips to the renderer (vkCreateBuffer, vkGetBufferMemoryRequirements2),
each a wait that gives the CPU away (0010). metal2vulkan names a handle type for every buffer it places in an exportable or
imported block: WindowServer's main thread spent a third of its time there while a window was dragged
(CoreAnimation's copy_image_to_texture -> newBufferWithBytesNoCopy). The requirements depend on flags, usage and
handleTypes (Vulkan 12.7), so the handle types join the cache index and such buffers are created asynchronously too.

--- a/src/virtio/vulkan/vn_buffer.c
+++ b/src/virtio/vulkan/vn_buffer.c
@@ -57,6 +57,7 @@
     * usage must not be 0
     */
    uint64_t usage = (uint64_t)create_info->usage;
+   uint64_t handle_types = 0;
    vk_foreach_struct_const(sType, pnext, create_info->pNext) {
       switch (sType) {
       case VK_STRUCTURE_TYPE_BUFFER_USAGE_FLAGS_2_CREATE_INFO: {
@@ -64,6 +65,18 @@
          usage = (uint64_t)usage2->usage;
          break;
       }
+      case VK_STRUCTURE_TYPE_EXTERNAL_MEMORY_BUFFER_CREATE_INFO: {
+         /* The requirements are those of flags, usage and handleTypes (12.7,
+          * quoted below), so the handle types go in the index. Without this
+          * a buffer that names a handle type costs two synchronous round
+          * trips to the renderer; metal2vulkan names one for every buffer it
+          * places in an exportable or imported block, and WindowServer made
+          * such buffers for a third of its main thread's time.
+          */
+         const VkExternalMemoryBufferCreateInfo *external = pnext;
+         handle_types = (uint64_t)external->handleTypes;
+         break;
+      }
       default:
          /* Other pNext structs are not cacheable. */
          return 0;
@@ -71,17 +84,22 @@
    }
 
    /* Only 34 bits are taken for VkBufferUsageFlagBits2 as of spec 1.4.339. We
-    * preserve 51 bits for the usage flags.
+    * preserve 36 bits for the usage flags, and 15 for the external memory
+    * handle types (14 are taken).
     */
-   if (usage & 0xFFF8000000000000ULL)
+   if (usage & 0xFFFFFFF000000000ULL)
       return 0;
+   if (handle_types & ~0x7FFFULL)
+      return 0;
 
-   /* Combine sharing mode, flags and usage bits to form a unique index:
+   /* Combine sharing mode, flags, handle types and usage bits to form a
+    * unique index:
     *
-    * | 63: concurrent | 51 ~ 62: create flags | 0 ~ 50: usage |
+    * | 63: concurrent | 51 ~ 62: create flags | 36 ~ 50: handle types |
+    * | 0 ~ 35: usage |
     */
    return (uint64_t)is_concurrent << 63 | (uint64_t)create_info->flags << 51 |
-          usage;
+          handle_types << 36 | usage;
 }
 
 static inline uint64_t
