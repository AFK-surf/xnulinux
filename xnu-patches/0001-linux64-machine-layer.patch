+static thread_t linux64_svc_thread;	/* linux64_trace: the thread whose system call is in flight, and its number */
+static long long linux64_svc_num;
+
+/* LINUX64: user-space exceptions by class for the host (linux64_abi.h, LINUX64_EL0_CLASSES) */
+uint64_t linux64_el0_stat[LINUX64_EL0_CPUS][2][LINUX64_EL0_CLASSES];
+static uint64_t linux64_el0_t0[LINUX64_EL0_CPUS];
+static uint8_t linux64_el0_cls[LINUX64_EL0_CPUS];
+
+void
+linux64_thread_bootstrap_return(void)
+{
+	thread_t thread = current_thread();
+
+	static int reported;
+
+	(void)ml_set_interrupts_enabled(FALSE);
+	ast_taken_user();
+	if (linux64_svc_thread == thread && linux64_tracing()) {	/* what the system call returned (C set: x0 is errno) */
+		linux64_svc_thread = NULL;
+		extern int proc_selfpid(void);
+		kprintf("linux64: [%d] svc %lld -> x0 0x%llx x1 0x%llx%s\n", proc_selfpid(), linux64_svc_num, get_saved_state_reg(thread->machine.upcb, 0),
+		    get_saved_state_reg(thread->machine.upcb, 1), (get_saved_state_cpsr(thread->machine.upcb) & PSR64_C) ? " (error)" : "");
+	}
+	if (reported++ == 0) {
+		linux64_call2(LINUX64_CALL_USER_ENTER, get_saved_state_pc(thread->machine.upcb), 0);
+	}
+	/*
+	 * An arm64 (not arm64e) process runs the arm64e system libraries with JOP off: Apple hardware disables the user
+	 * IA/DA keys for it; hosted, user code runs with SCTLR_EL1.EnIA/EnDA cleared (linux64_el0_run puts them back on
+	 * the next exception), or a blraaz on one of its unsigned function pointers fails (EXC_ARM_PAC_FAIL).
+	 */
+#if PRECISE_USER_KERNEL_TIME
+	recount_enter_user();		/* user time vs system time, as locore's return to user space does */
+#endif
+	{	/* the host's per-class accounting (linux64_abi.h): the exception this CPU took last is now done */
+		unsigned int slot = (unsigned int)cpu_number() & (LINUX64_EL0_CPUS - 1);
+		if (linux64_el0_t0[slot] != 0) {
+			linux64_el0_stat[slot][1][linux64_el0_cls[slot]] += __builtin_arm_rsr64("CNTVCT_EL0") - linux64_el0_t0[slot];
+			linux64_el0_t0[slot] = 0;
+		}
+	}
+	linux64_el0_run(thread->machine.upcb, (thread->machine.arm_machine_flags & ARM_MACHINE_THREAD_DISABLE_USER_JOP) != 0);
+}
+
+/* LINUX64: the registers linux64_el0_vectors saved for an exception taken at EL0 (cswitch.s) */
+struct linux64_el0_frame {
+	uint64_t x[31];
+	uint64_t sp, pc, cpsr, esr, far;
+	uint64_t neon[64];			/* q0..q31 */
+	uint32_t fpsr, fpcr;
+	uint64_t pad;
+};
+_Static_assert(__builtin_offsetof(struct linux64_el0_frame, neon) == 288, "linux64_el0_frame layout");
+_Static_assert(sizeof(struct linux64_el0_frame) == 36 * 8 + 528, "linux64_el0_frame size");
+
+void linux64_el0_exception(struct linux64_el0_frame *f) __attribute__((noreturn));
+void
+linux64_el0_exception(struct linux64_el0_frame *f)
+{
+	thread_t thread = current_thread();
+	arm_saved_state_t *ss = thread->machine.upcb;
+
+#if PRECISE_USER_KERNEL_TIME
+	recount_leave_user();		/* interrupts are still off here, as on locore's exception entry */
+#endif
+	linux64_count(LINUX64_CTR_EL0_EXC);	/* for the host's monitor: EL0 exceptions, the last one's ESR, FAR, PC */
+	{
+		unsigned int slot = (unsigned int)cpu_number() & (LINUX64_EL0_CPUS - 1), ec = (unsigned int)ESR_EC(f->esr);
+		unsigned int cls = f->esr == ~0ULL ? 3 : ec == ESR_EC_SVC_64 ? 0 : ec == ESR_EC_DABORT_EL0 ? 1 : ec == ESR_EC_IABORT_EL0 ? 2 : 4;
+		linux64_el0_stat[slot][0][cls]++;
+		linux64_el0_cls[slot] = (uint8_t)cls;
+		linux64_el0_t0[slot] = __builtin_arm_rsr64("CNTVCT_EL0");
+	}
+	linux64_dbg[LINUX64_CTR_EL0_ESR] = f->esr;
+	linux64_dbg[LINUX64_CTR_EL0_FAR] = f->far;
+	linux64_dbg[LINUX64_CTR_EL0_PC] = f->pc;
+	if (linux64_tracing()) kprintf("linux64: EL0 exception esr 0x%llx far 0x%llx pc 0x%llx x16 %lld ttbr0 0x%llx ttep 0x%llx\n", f->esr, f->far, f->pc, f->x[16],
+	    linux64_el0 ? 0ULL : __builtin_arm_rsr64("TTBR0_EL1"), (uint64_t)thread->map->pmap->ttep);
+	/*
+	 * The whole user state at once, signed once as locore's exception entry does (HAS_APPLE_PAC): the per-field setters
+	 * each check the old signature and sign again, five times per exception. EL0 runs with IRQ/FIQ masked while hosted
+	 * (no XNU interrupts at EL0 yet); XNU must see the user's own PSTATE, or its abort path takes the user fault for
+	 * one from a non-interruptible context.
+	 */
+	{
+		arm_saved_state64_t *s64 = saved_state64(ss);
+		uint32_t cpsr = (uint32_t)f->cpsr & ~(uint32_t)0x3c0;
+		for (unsigned i = 0; i < 29; i++) {
+			if (i != 16 && i != 17) {
+				s64->x[i] = f->x[i];
+			}
+		}
+		s64->fp = f->x[29];
+		s64->sp = f->sp;
+#if HAS_APPLE_PAC
+		uint64_t intr = ml_pac_safe_interrupts_disable();
+		if (linux64_el0) {
+			asm volatile (
+				"mov	x9, lr"				"\n"
+				"mov	x0, %[ss]"			"\n"
+				"mov	x1, %[pc]"			"\n"
+				"mov	w2, %w[cpsr]"			"\n"
+				"mov	x3, %[lr]"			"\n"
+				"mov	x4, %[x16]"			"\n"
+				"mov	x5, %[x17]"			"\n"
+				"str	x1, [x0, %[SS64_PC]]"		"\n"
+				"str	w2, [x0, %[SS64_CPSR]]"		"\n"
+				"str	x3, [x0, %[SS64_LR]]"		"\n"
+				"stp	x4, x5, [x0, %[SS64_X16]]"	"\n"
+				"bl	_ml_sign_thread_state"		"\n"
+				"mov	lr, x9"				"\n"
+				:
+				: [ss] "r"(ss), [pc] "r"(f->pc), [cpsr] "r"(cpsr), [lr] "r"(f->x[30]), [x16] "r"(f->x[16]), [x17] "r"(f->x[17]),
+				  [SS64_X16] "i"(ss64_offsetof(x[16])), [SS64_PC] "i"(ss64_offsetof(pc)),
+				  [SS64_CPSR] "i"(ss64_offsetof(cpsr)), [SS64_LR] "i"(ss64_offsetof(lr))
+				: "x0", "x1", "x2", "x3", "x4", "x5", "x6", "x7", "x8", "x9", "x16", "x17", "memory"
+			);
+		} else {
+			asm volatile (
+				"mov	x9, lr"				"\n"
+				"mov	x0, %[ss]"			"\n"
+				"mrs	x10, SPSel"			"\n"
+				"msr	SPSel, #1"			"\n"
+				"mov	x1, %[pc]"			"\n"
+				"mov	w2, %w[cpsr]"			"\n"
+				"mov	x3, %[lr]"			"\n"
+				"mov	x4, %[x16]"			"\n"
+				"mov	x5, %[x17]"			"\n"
+				"str	x1, [x0, %[SS64_PC]]"		"\n"
+				"str	w2, [x0, %[SS64_CPSR]]"		"\n"
+				"str	x3, [x0, %[SS64_LR]]"		"\n"
+				"stp	x4, x5, [x0, %[SS64_X16]]"	"\n"
+				"bl	_ml_sign_thread_state"		"\n"
+				"msr	SPSel, x10"			"\n"
+				"mov	lr, x9"				"\n"
+				:
+				: [ss] "r"(ss), [pc] "r"(f->pc), [cpsr] "r"(cpsr), [lr] "r"(f->x[30]), [x16] "r"(f->x[16]), [x17] "r"(f->x[17]),
+				  [SS64_X16] "i"(ss64_offsetof(x[16])), [SS64_PC] "i"(ss64_offsetof(pc)),
+				  [SS64_CPSR] "i"(ss64_offsetof(cpsr)), [SS64_LR] "i"(ss64_offsetof(lr))
+				: "x0", "x1", "x2", "x3", "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x16", "x17", "memory"
+			);
+		}
+		ml_pac_safe_interrupts_restore(intr);
+#else
+		s64->x[16] = f->x[16];
+		s64->x[17] = f->x[17];
+		s64->lr = f->x[30];
+		s64->pc = f->pc;
+		s64->cpsr = cpsr;
+#endif
+	}
+	{
+		arm_neon_saved_state_t *ns = thread->machine.uNeon;
+		memcpy(&ns->ns_64.v.q[0], f->neon, sizeof(f->neon));
+		ns->ns_64.fpsr = f->fpsr;
+		ns->ns_64.fpcr = f->fpcr;
+	}
+	if (f->esr == ~0ULL) {
+		/*
+		 * A host IRQ arrived while user code ran (EL0 runs with IRQs unmasked). Let Linux take it and run what it
+		 * must (its tick, RCU, other tasks), then deliver XNU's timer "interrupt" if it is due, as sleh_irq
+		 * would: the quantum expiry it may raise preempts this thread on the way back to user space.
+		 */
+		cpu_data_t *cdp = getCpuDatap();
+		(void)ml_set_interrupts_enabled(FALSE);	/* XNU's (virtual) interrupt state: off, as in sleh_irq */
+		linux64_call2(LINUX64_CALL_PREEMPTED, 0, 0);
+		if (cdp->rtcPop != EndOfAllTime && cdp->rtcPop != 0 && mach_absolute_time() >= cdp->rtcPop) {
+			cdp->cpu_int_state = ss;
+			cdp->cpu_stat.irq_ex_cnt++;
+			cdp->cpu_decrementer = -1;
+			rtclock_intr(TRUE);
+			cdp->cpu_int_state = NULL;
+		}
+		if (os_atomic_load(&linux64_ipi_pending[linux64_cpu_slot()], relaxed)) {	/* another CPU's IPI, as sleh_fiq takes it */
+			cdp->cpu_int_state = ss;
+			linux64_ipi_take();
+			cdp->cpu_int_state = NULL;
+		}
+		thread_exception_return();
+	}
+	if (ESR_EC(f->esr) == ESR_EC_SVC_64 && linux64_tracing()) {
+		long long num = (long long)f->x[16];
+		linux64_svc_thread = thread;
+		linux64_svc_num = num;
+		if (num == 202 && f->x[1] > 0 && f->x[1] <= 8) {	/* sysctl: the MIB and this thread's kernel stack */
+			int mib[8] = {0};
+			if (copyin((user_addr_t)f->x[0], mib, f->x[1] * sizeof(int)) == 0) {
+				kprintf("linux64: svc 202 mib %d.%d.%d.%d (len %llu) kstack 0x%llx\n", mib[0], mib[1], mib[2], mib[3], f->x[1],
+				    (uint64_t)thread->kernel_stack);
+			}
+		}
+		if (num == 59 || num == 244 || num == 5 || num == 398 || num == 463 || num == 33 || num == 338 || num == 340 || num == 466 || num == 469) {
+			char path[128];
+			size_t len = 0;
+			uint64_t ua = (num == 463 || num == 466 || num == 469 || num == 244) ? f->x[1] : f->x[0];
+			if (copyinstr((user_addr_t)ua, path, sizeof(path), &len) == 0) {
+				extern int proc_selfpid(void);
+				kprintf("linux64: [%d] svc %lld path \"%s\"\n", proc_selfpid(), num, path);
+			}
+		}
+	}
+	sleh_synchronous(thread->machine.contextData, f->esr, (vm_offset_t)f->far, false);
+	thread_exception_return();
+}
+
+void linux64_el0_utcb_entry(arm_saved_state_t *ss, unsigned long disable_jop) __attribute__((noreturn));
+void
+linux64_el0_utcb_entry(arm_saved_state_t *ss, unsigned long disable_jop)
+{
+	thread_t thread = current_thread();
+	pmap_t pmap = thread->map->pmap;
+	arm_saved_state64_t *s64 = saved_state64(ss);
+	arm_neon_saved_state_t *ns = thread->machine.uNeon;
+	struct linux64_utcb_req req;
+	struct linux64_el0_frame f;
+
+	req.as_handle = linux64_el0_ensure_as(pmap);
+	if (!req.as_handle) {
+		panic("linux64_el0_utcb_entry: failed to allocate user AS for pmap %p", pmap);
+	}
+	req.thread_id = thread->thread_id;
+	req.disable_jop = disable_jop;
+	for (unsigned i = 0; i < 29; i++) {
+		req.x[i] = s64->x[i];
+	}
+	req.x[29] = s64->fp;
+	req.x[30] = s64->lr;
+	req.sp = s64->sp;
+	req.pc = s64->pc;
+	req.pstate = s64->cpsr;
+	req.tpidr = 0;
+	req.tpidrro = (uint64_t)thread->machine.cthread_self;
+	memcpy(req.neon, &ns->ns_64.v.q[0], sizeof(req.neon));
+	req.fpsr = ns->ns_64.fpsr;
+	req.fpcr = ns->ns_64.fpcr;
+	req.fpu_dirty = 1;
+
+	for (;;) {
+		req.result = 0;
+		linux64_call(LINUX64_CALL_UTCB_RUN, &req);
+		if (req.result != 0) {
+			panic("linux64_el0_utcb_entry: UTCB_RUN failed (%lld)", (long long)req.result);
+		}
+		if (req.stop_kind == LINUX64_STOP_PAGEFAULT &&
+		    linux64_el0_sync_user_pte(pmap, (vm_offset_t)req.fault_addr, req.esr)) {
+			continue;
+		}
+		break;
+	}
+
+	for (unsigned i = 0; i < 31; i++) {
+		f.x[i] = req.x[i];
+	}
+	f.sp = req.sp;
+	f.pc = req.pc;
+	f.cpsr = req.pstate;
+	f.esr = req.esr;
+	f.far = req.fault_addr;
+	memcpy(f.neon, req.neon, sizeof(f.neon));
+	f.fpsr = req.fpsr;
+	f.fpcr = req.fpcr;
+	f.pad = 0;
+	linux64_el0_exception(&f);
+}
