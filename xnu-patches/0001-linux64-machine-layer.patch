+		}
+		if (os_atomic_load(&linux64_ipi_pending[linux64_cpu_slot()], relaxed)) {	/* another CPU's IPI, as sleh_fiq takes it */
+			cdp->cpu_int_state = ss;
+			linux64_ipi_take();
+			cdp->cpu_int_state = NULL;
+		}
+		thread_exception_return();
+	}
+	if (ESR_EC(esr) == ESR_EC_SVC_64 && linux64_tracing()) {
+		long long num = (long long)x[16];
+		linux64_svc_thread = thread;
+		linux64_svc_num = num;
+		if (num == 202 && x[1] > 0 && x[1] <= 8) {	/* sysctl: the MIB and this thread's kernel stack */
+			int mib[8] = {0};
+			if (copyin((user_addr_t)x[0], mib, x[1] * sizeof(int)) == 0) {
+				kprintf("linux64: svc 202 mib %d.%d.%d.%d (len %llu) kstack 0x%llx\n", mib[0], mib[1], mib[2], mib[3], x[1],
+				    (uint64_t)thread->kernel_stack);
+			}
+		}
+		if (num == 59 || num == 244 || num == 5 || num == 398 || num == 463 || num == 33 || num == 338 || num == 340 || num == 466 || num == 469) {
+			char path[128];
+			size_t len = 0;
+			uint64_t ua = (num == 463 || num == 466 || num == 469 || num == 244) ? x[1] : x[0];
+			if (copyinstr((user_addr_t)ua, path, sizeof(path), &len) == 0) {
+				extern int proc_selfpid(void);
+				kprintf("linux64: [%d] svc %lld path \"%s\"\n", proc_selfpid(), num, path);
+			}
+		}
+	}
+	sleh_synchronous(thread->machine.contextData, esr, (vm_offset_t)far, false);
+	thread_exception_return();
+}
+
+void linux64_el0_exception(struct linux64_el0_frame *f) __attribute__((noreturn));
+void
+linux64_el0_exception(struct linux64_el0_frame *f)
+{
+	arm_neon_saved_state_t *ns = current_thread()->machine.uNeon;
+	memcpy(&ns->ns_64.v.q[0], f->neon, sizeof(f->neon));
+	ns->ns_64.fpsr = f->fpsr;
+	ns->ns_64.fpcr = f->fpcr;
+	linux64_el0_dispatch(f->x, f->sp, f->pc, f->cpsr, f->esr, f->far);
+}
+
+void linux64_el0_utcb_entry(arm_saved_state_t *ss, unsigned long disable_jop) __attribute__((noreturn));
+void
+linux64_el0_utcb_entry(arm_saved_state_t *ss, unsigned long disable_jop)
+{
+	thread_t thread = current_thread();
+	pmap_t pmap = thread->map->pmap;
+	arm_saved_state64_t *s64 = saved_state64(ss);
+	arm_neon_saved_state_t *ns = thread->machine.uNeon;
+	struct linux64_utcb_req req;
+	uint64_t cpu_tpidr;
+
+	req.as_handle = linux64_el0_ensure_as(pmap);
+	if (!req.as_handle) {
+		panic("linux64_el0_utcb_entry: failed to allocate user AS for pmap %p", pmap);
+	}
+	req.thread_id = thread->thread_id;
+	req.disable_jop = disable_jop;
+#if defined(HAS_APPLE_PAC)
+	req.rop_pid = thread->machine.rop_pid;
+	req.jop_pid = thread->machine.jop_pid;
+#else
+	req.rop_pid = 0;
+	req.jop_pid = 0;
+#endif
+	for (unsigned i = 0; i < 29; i++) {
+		req.x[i] = s64->x[i];
+	}
+	req.x[29] = s64->fp;
+	req.x[30] = s64->lr;
+	req.sp = s64->sp;
+	req.pc = s64->pc;
+	req.pstate = s64->cpsr;
+	cpu_tpidr = thread->machine.CpuDatap->cpu_tpidr_el0 & MACHDEP_TPIDR_CPU_DATA_MASK;
+	req.tpidr = (thread->machine.linux64_user_tpidr & ~MACHDEP_TPIDR_CPU_DATA_MASK) | cpu_tpidr;
+	req.tpidrro = (uint64_t)thread->machine.cthread_self;
+	req.neon_ptr = (uint64_t)(uintptr_t)&ns->ns_64;
+	req.fpu_dirty = 0;
+
+	unsigned long run_call = LINUX64_CALL_UTCB_RUN;
+	for (;;) {
+		req.result = 0;
+		linux64_call(run_call, &req);
+		if (req.result != 0) {
+			panic("linux64_el0_utcb_entry: UTCB_%s failed (%lld)",
+			    run_call == LINUX64_CALL_UTCB_RESUME ? "RESUME" : "RUN",
+			    (long long)req.result);
+		}
+		if (req.stop_kind == LINUX64_STOP_PAGEFAULT) {
+			if (linux64_el0_sync_user_pte(pmap, (vm_offset_t)req.fault_addr, req.esr)) {
+				run_call = LINUX64_CALL_UTCB_RESUME;
+				continue;
+			}
+			req.result = 0;
+			linux64_call(LINUX64_CALL_UTCB_SYNC_REGS, &req);
+			if (req.result != 0) {
+				panic("linux64_el0_utcb_entry: UTCB_SYNC_REGS failed (%lld)",
+				    (long long)req.result);
+			}
+		}
+		break;
+	}
+
+	thread->machine.linux64_user_tpidr = req.tpidr;
+	{
+		struct linux64_el0_pcpu *pcpu = &linux64_el0_pcpu[linux64_cpu_slot()];
+		pcpu->fpu_tid = thread->thread_id;
+		pcpu->fpu_live = 1;
+	}
+	linux64_el0_dispatch(req.x, req.sp, req.pc, req.pstate, req.esr, req.fault_addr);
+}
