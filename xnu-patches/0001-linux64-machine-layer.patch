+ * CPU's host side waits for this one (an IPI, a lock), neither moves. So every ~1 ms of spinning the host takes this
+ * CPU's interrupts (LINUX64_CALL_PREEMPTED). Nothing of XNU's runs here (no IPI, no AST): the spinning code may hold
+ * per-CPU lock state that a context switch would break.
+ */
+static uint64_t linux64_last_relax[LINUX64_CPU_SLOTS];
+void
+linux64_spin_relax(void)
+{
+	unsigned int slot = linux64_cpu_slot();
+	uint64_t now = mach_absolute_time();
+
+	if (now - linux64_last_relax[slot] < 24000) {     /* ~1 ms of the 24 MHz timebase */
+		return;
+	}
+	linux64_last_relax[slot] = now;
+	linux64_call2(LINUX64_CALL_PREEMPTED, 1, 0);
+	/*
+	 * Spinning with XNU's interrupts enabled, a CPU takes another CPU's IPI on hardware (its FIQ): the other may be
+	 * waiting for exactly that (a cross-call's acknowledgment) before it lets go of what this one spins on. Take a
+	 * pending one here as the FIQ would, interrupts off around the handler; no AST, no context switch.
+	 */
+	if (linux64_vint[slot] && getCpuDatap()->cpu_int_state == NULL) {
+		linux64_vint[slot] = 0;
+		linux64_ipi_take();
+		linux64_vint[slot] = 1;
+	}
+}
+
+void
+linux64_ipi_take(void)
+{
+	unsigned int slot = linux64_cpu_slot();
+
+	if (os_atomic_load(&linux64_ipi_pending[slot], relaxed) && os_atomic_xchg(&linux64_ipi_pending[slot], 0, acquire)) {
+		cpu_signal_handler();
+	}
+}
+
+void
+linux64_cpu_signal(unsigned int cpu)
+{
+	cpu_data_t *target = CpuDataEntries[cpu].cpu_data_vaddr;
+	uint64_t mpidr;
+
+	if (target == NULL) {
+		return;
+	}
+	mpidr = target->cpu_phys_id;
+	os_atomic_store(&linux64_ipi_pending[LINUX64_CPU_SLOT(mpidr)], 1, release);
+	linux64_call2(LINUX64_CALL_IPI, mpidr, 0);
+}
