+bool
+linux64_el0_sync_user_pte(pmap_t pmap, vm_offset_t far, uint64_t esr)
+{
+	if (!linux64_el0 || !pmap || pmap == kernel_pmap) {
+		return false;
+	}
+	uint64_t as = linux64_el0_ensure_as(pmap);
+	if (!as) {
+		return false;
+	}
+	uint64_t ufar = (uint64_t)((int64_t)(far << 8) >> 8);
+	if (ufar >= 0x0001000000000000ULL) {
+		return false;
+	}
+	vm_map_address_t va = (vm_map_address_t)(ufar & ~0xfffULL);
+	uint32_t ec = (uint32_t)((esr >> 26) & 0x3f);
+	bool is_exec = (ec == 0x20 || ec == 0x21);
+	bool is_write = (!is_exec) && ((esr & (1u << 6)) != 0) && ((esr & (1u << 8)) == 0);
+
+	pmap_lock(pmap, PMAP_LOCK_SHARED);
+	pt_entry_t *ptep = pmap_pte(pmap, va);
+	pt_entry_t pte = ptep ? *ptep : ARM_PTE_EMPTY;
+
+	if (!pte_is_valid(pte) || !(pte & ARM_PTE_AF)) {
+		pmap_unlock(pmap, PMAP_LOCK_SHARED);
+		return false;
+	}
+	uint64_t ap = pte & ARM_PTE_APMASK;
+	if (ap != ARM_PTE_AP(AP_RORO) && ap != ARM_PTE_AP(AP_RWRW)) {
+		pmap_unlock(pmap, PMAP_LOCK_SHARED);
+		return false;
+	}
+	if (is_write && ap != ARM_PTE_AP(AP_RWRW)) {
+		pmap_unlock(pmap, PMAP_LOCK_SHARED);
+		return false;
+	}
+	if (is_exec && (pte & ARM_PTE_NX)) {
+		pmap_unlock(pmap, PMAP_LOCK_SHARED);
+		return false;
+	}
+	pmap_paddr_t pa = pte_to_pa(pte);
+	if (!pa_valid(pa)) {
+		pmap_unlock(pmap, PMAP_LOCK_SHARED);
+		return false;
+	}
+
+	struct linux64_map_req req = {
+		.as_handle = as,
+		.va = va,
+		.pa = pa,
+		.size = 4096,
+		.prot = LINUX64_PROT_READ |
+		    (ap == ARM_PTE_AP(AP_RWRW) ? LINUX64_PROT_WRITE : 0) |
+		    (!(pte & ARM_PTE_NX) ? LINUX64_PROT_EXEC : 0),
+	};
+	linux64_call(LINUX64_CALL_AS_MAP, &req);
+	__builtin_arm_dmb(DMB_ISH);
+	pt_entry_t cur = *(volatile pt_entry_t *)ptep;
+	if (cur != pte) {
+		struct linux64_map_req ureq = { .as_handle = as, .va = va, .size = 4096 };
+		linux64_call(LINUX64_CALL_AS_UNMAP, &ureq);
+		pmap_unlock(pmap, PMAP_LOCK_SHARED);
+		return false;
+	}
+	pmap_unlock(pmap, PMAP_LOCK_SHARED);
+	return req.result > 0;
+}
