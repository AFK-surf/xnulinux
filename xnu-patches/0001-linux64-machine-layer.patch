+/*
+ * LINUX64 (xnulinux): a data or instruction abort on an XNU kernel address, taken in Linux's vectors and forwarded by
+ * the host (xnu.ko through FKI). Does what handle_kernel_abort does for a kernel-map fault: the pmap fast path for
+ * permission/access-flag faults, then vm_fault. Returns KERN_SUCCESS when the access can be retried.
+ */
+kern_return_t linux64_kernel_fault(uint64_t far, uint64_t esr);
+kern_return_t
+linux64_kernel_fault(uint64_t far, uint64_t esr)
+{
+	uint32_t ec = (uint32_t)((esr >> 26) & 0x3f);
+	fault_status_t fault_code = (fault_status_t)(esr & 0x3f);
+	vm_prot_t fault_type = VM_PROT_READ;
+	kern_return_t result = KERN_FAILURE;
+
+	if (ec == 0x21) {               /* instruction abort, current EL */
+		fault_type = VM_PROT_READ | VM_PROT_EXECUTE;
+	} else if (ec == 0x25) {        /* data abort, current EL */
+		if (esr & (1u << 6)) {  /* WnR */
+			fault_type = VM_PROT_READ | VM_PROT_WRITE;
+		}
+	} else {
+		return KERN_FAILURE;
+	}
+	if (!is_vm_fault(fault_code)) {
+		return KERN_FAILURE;
+	}
+	/* a kernel address faults on the kernel map; a user one (copyio) on the current thread's map */
+	vm_map_t map = kernel_map;
+	if (!VM_KERNEL_ADDRESS(far)) {
+		thread_t thread = current_thread();
+		if (thread == THREAD_NULL || thread->map == VM_MAP_NULL || thread->map == kernel_map) {
+			return KERN_FAILURE;
+		}
+		map = thread->map;
+	}
+	kern_return_t ffr = KERN_FAILURE;
+	if (!is_translation_fault(fault_code)) {
+		ffr = arm_fast_fault(map->pmap, far, fault_type, (fault_code == FSC_ACCESS_FLAG_FAULT_L3), FALSE);
+	}
+	kern_return_t kr = ffr == KERN_SUCCESS ? KERN_SUCCESS :
+	    vm_fault(map, far, fault_type, FALSE, VM_KERN_MEMORY_NONE, THREAD_UNINT, NULL, 0);
+	if (ffr == KERN_SUCCESS) {
+		return KERN_SUCCESS;
+	}
+	return kr;
+}
