+struct el0_purgeable_snap {
+	vm_map_t        map;
+	vm_map_offset_t start;
+	vm_map_offset_t end;
+};
+
+kern_return_t
+vm_map_el0_sync_purgeable_object(
+	vm_object_t     object,
+	int             target_state)
+{
+	struct el0_purgeable_snap stack_snaps[16];
+	struct el0_purgeable_snap *snaps = stack_snaps;
+	size_t cap = 16, count = 0;
+	struct el0_purgeable_map_rec *cur;
+	kern_return_t kr = KERN_SUCCESS;
+
+	if (!linux64_el0 || object == VM_OBJECT_NULL) {
+		return KERN_SUCCESS;
+	}
+
+retry_snap:
+	count = 0;
+	lck_spin_lock(&el0_purgeable_track_lock);
+	if (TAILQ_EMPTY(&el0_purgeable_maps)) {
+		lck_spin_unlock(&el0_purgeable_track_lock);
+		if (snaps != stack_snaps) {
+			kfree_type(struct el0_purgeable_snap, cap, snaps);
+		}
+		return KERN_SUCCESS;
+	}
+	TAILQ_FOREACH(cur, &el0_purgeable_maps, link) {
+		if (cur->object == object) {
+			count++;
+		}
+	}
+	if (count == 0) {
+		lck_spin_unlock(&el0_purgeable_track_lock);
+		if (snaps != stack_snaps) {
+			kfree_type(struct el0_purgeable_snap, cap, snaps);
+		}
+		return KERN_SUCCESS;
+	}
+	if (count > cap) {
+		size_t need = count;
+		lck_spin_unlock(&el0_purgeable_track_lock);
+		if (snaps != stack_snaps) {
+			kfree_type(struct el0_purgeable_snap, cap, snaps);
+		}
+		snaps = kalloc_type(struct el0_purgeable_snap, need, Z_WAITOK);
+		cap = need;
+		goto retry_snap;
+	}
+	size_t idx = 0;
+	TAILQ_FOREACH(cur, &el0_purgeable_maps, link) {
+		if (cur->object == object) {
+			vm_map_reference(cur->map);
+			snaps[idx].map = cur->map;
+			snaps[idx].start = cur->start;
+			snaps[idx].end = cur->end;
+			idx++;
+		}
+	}
+	lck_spin_unlock(&el0_purgeable_track_lock);
+
+	if (target_state == VM_PURGABLE_NONVOLATILE) {
+		for (size_t i = 0; i < idx; i++) {
+			kern_return_t fkr = vm_map_wire_el0_autowire_obj(
+			    snaps[i].map, snaps[i].start, snaps[i].end, object);
+			if (fkr == KERN_INVALID_ADDRESS) {
+				el0_purgeable_track_remove_exact(
+				    snaps[i].map, object, snaps[i].start, snaps[i].end);
+				continue;
+			}
+			if (fkr != KERN_SUCCESS) {
+				for (size_t j = 0; j < i; j++) {
+					(void)vm_map_unwire_el0_autowire_obj(
+					    snaps[j].map, snaps[j].start, snaps[j].end, object);
+				}
+				kr = fkr;
+				break;
+			}
+		}
+	} else if (target_state == VM_PURGABLE_VOLATILE || target_state == VM_PURGABLE_EMPTY) {
+		for (size_t i = 0; i < idx; i++) {
+			kern_return_t uk = vm_map_unwire_el0_autowire_obj(
+			    snaps[i].map, snaps[i].start, snaps[i].end, object);
+			if (uk == KERN_INVALID_ADDRESS) {
+				el0_purgeable_track_remove_exact(
+				    snaps[i].map, object, snaps[i].start, snaps[i].end);
+				continue;
+			}
+			if (uk != KERN_SUCCESS && kr == KERN_SUCCESS) {
+				kr = uk;
+			}
+		}
+	}
+
+	for (size_t i = 0; i < idx; i++) {
+		vm_map_deallocate(snaps[i].map);
+	}
+	if (snaps != stack_snaps) {
+		kfree_type(struct el0_purgeable_snap, cap, snaps);
+	}
+	return kr;
+}
