+static kern_return_t
+vm_map_unwire_el0_autowire_match(
+	vm_map_t                map,
+	vm_map_offset_t         start,
+	vm_map_offset_t         end,
+	vm_object_t             expected_obj,
+	bool                    check_offset,
+	vm_object_offset_t      expected_offset,
+	bool                    skip_mismatch)
+{
+	vm_map_entry_t          entry;
+	kern_return_t           kr;
+	VM_MAP_LOCK_CTX_DECLARE(ctx);
+
+	if (map == VM_MAP_NULL || map->pmap != kernel_pmap) {
+		return KERN_SUCCESS;
+	}
+
+	VM_MAP_CLAMP_TO_MAP_BOUNDS(map, start, end);
+	start = vm_map_trunc_page(start, VM_MAP_PAGE_MASK(map));
+	end = vm_map_round_page(end, VM_MAP_PAGE_MASK(map));
+	if (start >= end) {
+		return KERN_SUCCESS;
+	}
+
+	ctx->vmlc_preflight = ^kern_return_t (vm_map_lock_ctx_t vctx, vm_map_entry_t vme) {
+		(void)vctx;
+		if (vme->superpage_size) {
+			return KERN_INVALID_ADDRESS;
+		}
+		if (!skip_mismatch && expected_obj != VM_OBJECT_NULL &&
+		    (vme->is_sub_map || VME_OBJECT(vme) != expected_obj)) {
+			return KERN_INVALID_ADDRESS;
+		}
+		return KERN_SUCCESS;
+	};
+
+	kr = vm_map_range_ex_lock(ctx, &map, start, end,
+	    VMRL_EX_ATOMIC | VMRL_EX_SIMPLIFY);
+	if (kr != KERN_SUCCESS) {
+		return kr;
+	}
+
+	while ((entry = vm_map_range_atomic_next(ctx))) {
+		if (entry->is_sub_map || !entry->vme_el0_autowire) {
+			continue;
+		}
+		if (expected_obj != VM_OBJECT_NULL && VME_OBJECT(entry) != expected_obj) {
+			continue;
+		}
+		if (check_offset &&
+		    VME_OFFSET(entry) != expected_offset + (entry->vme_start - start)) {
+			continue;
+		}
+		entry->vme_el0_autowire = 0;
+		if (vm_map_wire_count_sub(ctx->vmlc_map, entry, FALSE)) {
+			assert(!entry->is_sub_map);
+			entry->zero_wired_pages = FALSE;
+			vm_fault_unwire(ctx->vmlc_map, entry, false, ctx->vmlc_map->pmap,
+			    entry->vme_start, entry->vme_end);
+		}
+	}
+
+	vm_map_range_ex_unlock(ctx, &map);
+	return KERN_SUCCESS;
+}
