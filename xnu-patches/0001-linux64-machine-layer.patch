+/*
+ * LINUX64 (xnulinux): the first return of a new user thread (thread_bootstrap_return) while hosted. The pending ASTs
+ * run as on the way to user space (for the first BSD thread: bsdinit_task, which execs launchd), and the thread enters
+ * user space through linux64_el0_run (the host is told where user space starts the first time).
+ */
+void linux64_thread_bootstrap_return(void) __attribute__((noreturn));
+/* boot-arg linux64_trace=1 logs every EL0 exception, and system calls with their paths and results */
+static int linux64_trace_level = -1;
+static inline int
+linux64_tracing(void)
+{
+	if (__improbable(linux64_trace_level < 0)) {
+		int v = 0;
+		if (!PE_parse_boot_argn("linux64_trace", &v, sizeof(v))) {
+			v = 0;
+		}
+		linux64_trace_level = v;
+	}
+	return linux64_trace_level;
+}
+
+static thread_t linux64_svc_thread;	/* linux64_trace: the thread whose system call is in flight, and its number */
+static long long linux64_svc_num;
