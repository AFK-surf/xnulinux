+_Static_assert(sizeof(arm_neon_saved_state64_t) >= 520, "arm_neon_saved_state64_t size");
+_Static_assert(__builtin_offsetof(arm_neon_saved_state64_t, v.q[0]) == 0, "ns_64 v.q[0] offset");
+_Static_assert(__builtin_offsetof(arm_neon_saved_state64_t, fpsr) == 512, "ns_64 fpsr offset");
+_Static_assert(__builtin_offsetof(arm_neon_saved_state64_t, fpcr) == 516, "ns_64 fpcr offset");
