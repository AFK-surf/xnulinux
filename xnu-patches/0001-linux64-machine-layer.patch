+struct el0_purgeable_map_rec {
+	TAILQ_ENTRY(el0_purgeable_map_rec) link;
+	vm_map_t        map;
+	vm_object_t     object;
+	vm_map_offset_t start;
+	vm_map_offset_t end;
+};
+
+static TAILQ_HEAD(el0_purgeable_map_head, el0_purgeable_map_rec) el0_purgeable_maps =
+    TAILQ_HEAD_INITIALIZER(el0_purgeable_maps);
+
+static void
+el0_purgeable_track_add(
+	vm_map_t        map,
+	vm_object_t     object,
+	vm_map_offset_t start,
+	vm_map_offset_t end)
+{
+	struct el0_purgeable_map_head to_free;
+	struct el0_purgeable_map_rec *node, *cur, *tmp;
+
+	if (!linux64_el0 || map == VM_MAP_NULL || map->pmap != kernel_pmap ||
+	    object == VM_OBJECT_NULL || start >= end) {
+		return;
+	}
+	TAILQ_INIT(&to_free);
+	node = kalloc_type(struct el0_purgeable_map_rec, Z_WAITOK);
+	node->map = map;
+	node->object = object;
+	node->start = start;
+	node->end = end;
+
+	lck_spin_lock(&el0_purgeable_track_lock);
+	TAILQ_FOREACH_SAFE(cur, &el0_purgeable_maps, link, tmp) {
+		if (cur->map == map && cur->object == object &&
+		    cur->start == start && cur->end == end) {
+			lck_spin_unlock(&el0_purgeable_track_lock);
+			kfree_type(struct el0_purgeable_map_rec, node);
+			return;
+		}
+		if (cur->map == map && cur->start < end && cur->end > start) {
+			TAILQ_REMOVE(&el0_purgeable_maps, cur, link);
+			TAILQ_INSERT_TAIL(&to_free, cur, link);
+		}
+	}
+	TAILQ_INSERT_TAIL(&el0_purgeable_maps, node, link);
+	lck_spin_unlock(&el0_purgeable_track_lock);
+
+	TAILQ_FOREACH_SAFE(cur, &to_free, link, tmp) {
+		TAILQ_REMOVE(&to_free, cur, link);
+		kfree_type(struct el0_purgeable_map_rec, cur);
+	}
+}
+
+static void
+el0_purgeable_track_remove(
+	vm_map_t        map,
+	vm_map_offset_t start,
+	vm_map_offset_t end)
+{
+	struct el0_purgeable_map_head to_free;
+	struct el0_purgeable_map_rec *cur, *tmp, *split_node = NULL;
+
+	if (!linux64_el0 || map == VM_MAP_NULL || map->pmap != kernel_pmap || start >= end) {
+		return;
+	}
+	TAILQ_INIT(&to_free);
+
+	lck_spin_lock(&el0_purgeable_track_lock);
+	if (TAILQ_EMPTY(&el0_purgeable_maps)) {
+		lck_spin_unlock(&el0_purgeable_track_lock);
+		return;
+	}
+	TAILQ_FOREACH_SAFE(cur, &el0_purgeable_maps, link, tmp) {
+		if (cur->map != map || cur->end <= start || cur->start >= end) {
+			continue;
+		}
+		if (start <= cur->start && end >= cur->end) {
+			TAILQ_REMOVE(&el0_purgeable_maps, cur, link);
+			TAILQ_INSERT_TAIL(&to_free, cur, link);
+		} else if (start <= cur->start) {
+			cur->start = end;
+		} else if (end >= cur->end) {
+			cur->end = start;
+		} else {
+			/* Punch hole in middle: trim left, insert right tail. */
+			vm_map_offset_t orig_end = cur->end;
+			vm_object_t orig_obj = cur->object;
+			cur->end = start;
+			lck_spin_unlock(&el0_purgeable_track_lock);
+			split_node = kalloc_type(struct el0_purgeable_map_rec, Z_WAITOK);
+			split_node->map = map;
+			split_node->object = orig_obj;
+			split_node->start = end;
+			split_node->end = orig_end;
+			lck_spin_lock(&el0_purgeable_track_lock);
+			TAILQ_INSERT_TAIL(&el0_purgeable_maps, split_node, link);
+			break;
+		}
+	}
+	lck_spin_unlock(&el0_purgeable_track_lock);
+
+	TAILQ_FOREACH_SAFE(cur, &to_free, link, tmp) {
+		TAILQ_REMOVE(&to_free, cur, link);
+		kfree_type(struct el0_purgeable_map_rec, cur);
+	}
+}
+
+static void
+el0_purgeable_track_remove_exact(
+	vm_map_t        map,
+	vm_object_t     object,
+	vm_map_offset_t start,
+	vm_map_offset_t end)
+{
+	struct el0_purgeable_map_rec *cur, *tmp, *found = NULL;
+
+	lck_spin_lock(&el0_purgeable_track_lock);
+	TAILQ_FOREACH_SAFE(cur, &el0_purgeable_maps, link, tmp) {
+		if (cur->map == map && cur->object == object &&
+		    cur->start == start && cur->end == end) {
+			TAILQ_REMOVE(&el0_purgeable_maps, cur, link);
+			found = cur;
+			break;
+		}
+	}
+	lck_spin_unlock(&el0_purgeable_track_lock);
+	if (found) {
+		kfree_type(struct el0_purgeable_map_rec, found);
+	}
+}
+
+void
+vm_map_el0_revert_purgeable_object(
+	vm_object_t     object,
+	vm_purgable_t   control,
+	int             prev_state)
+{
+	int revert_state = prev_state;
+	kern_return_t rkr;
+
+	vm_object_lock(object);
+	rkr = vm_object_purgable_control(object, control, &revert_state);
+	if (rkr != KERN_SUCCESS) {
+		int no_aging = VM_PURGABLE_VOLATILE | VM_PURGABLE_NO_AGING;
+		rkr = vm_object_purgable_control(object, control, &no_aging);
+	}
+	if (rkr != KERN_SUCCESS) {
+		int empty_state = VM_PURGABLE_EMPTY;
+		rkr = vm_object_purgable_control(object, control, &empty_state);
+	}
+	assert(rkr == KERN_SUCCESS);
+	vm_object_unlock(object);
+}
