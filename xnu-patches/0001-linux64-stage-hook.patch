+	}
+}
+
+/*
+ * LINUX64 (xnulinux) PoC: without the corecrypto kext nobody calls register_and_init_prng(), so
+ * prng_funcs stays zeroed. Until the hosted kernel has a PRNG provider, read_random() falls back to
+ * a non-cryptographic xorshift generator seeded from early_random(). NOT FOR PRODUCTION.
+ */
+static uint64_t linux64_prng_state[2];
+static void
+linux64_prng_fill(uint8_t *p, size_t len)
+{
+	uint64_t *st = linux64_prng_state;
+	if (st[0] == 0 && st[1] == 0) {
+		st[0] = early_random() | 1;
+		st[1] = early_random();
+	}
+	while (len) {
+		uint64_t s1 = st[0], s0 = st[1];
+		st[0] = s0;
+		s1 ^= s1 << 23;
+		st[1] = s1 ^ s0 ^ (s1 >> 17) ^ (s0 >> 26);
+		uint64_t v = st[1] + s0;
+		size_t n = len < sizeof(v) ? len : sizeof(v);
+		memcpy(p, &v, n);
+		p += n;
+		len -= n;
+	}
 }
 
