+	uint64_t signed_fn = (uint64_t)ptrauth_sign_unauthenticated(fn, ptrauth_key_asia,
+	    ptrauth_blend_discriminator((void *)entry, 0x17dc));
+	uint64_t pa = kvtophys((vm_offset_t)entry);
+	if (pa) {
