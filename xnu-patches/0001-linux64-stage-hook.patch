 	 */
-	unsigned long result;
-	__asm__ ("mrs %0, TPIDR_EL1" : "=r" (result));
+	/* LINUX64 (xnulinux): TPIDR_EL1 belongs to Linux; the thread pointer lives in memory. */
+	extern unsigned long linux64_tpidr;
+	unsigned long result = linux64_tpidr;
 	return __unsafe_forge_single(thread_t, result);
