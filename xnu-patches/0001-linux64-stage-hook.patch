+
+/*
+ * LINUX64 (xnulinux): a data or instruction abort on an XNU kernel address, taken in Linux's vectors and forwarded by
+ * the host (xnu.ko through FKI). Does what handle_kernel_abort does for a kernel-map fault: the pmap fast path for
+ * permission/access-flag faults, then vm_fault. Returns KERN_SUCCESS when the access can be retried.
+ */
+kern_return_t linux64_kernel_fault(uint64_t far, uint64_t esr);
+kern_return_t
+linux64_kernel_fault(uint64_t far, uint64_t esr)
+{
+	uint32_t ec = (uint32_t)((esr >> 26) & 0x3f);
+	fault_status_t fault_code = (fault_status_t)(esr & 0x3f);
+	vm_prot_t fault_type = VM_PROT_READ;
+	kern_return_t result = KERN_FAILURE;
+
+	if (ec == 0x21) {               /* instruction abort, current EL */
+		fault_type = VM_PROT_READ | VM_PROT_EXECUTE;
+	} else if (ec == 0x25) {        /* data abort, current EL */
+		if (esr & (1u << 6)) {  /* WnR */
+			fault_type = VM_PROT_READ | VM_PROT_WRITE;
+		}
+	} else {
+		return KERN_FAILURE;
+	}
+	if (!is_vm_fault(fault_code)) {
+		return KERN_FAILURE;
+	}
+	/* a kernel address faults on the kernel map; a user one (copyio) on the current thread's map */
+	vm_map_t map = kernel_map;
+	if (!VM_KERNEL_ADDRESS(far)) {
+		thread_t thread = current_thread();
+		if (thread == THREAD_NULL || thread->map == VM_MAP_NULL || thread->map == kernel_map) {
+			return KERN_FAILURE;
+		}
+		map = thread->map;
+	}
+	if (!is_translation_fault(fault_code)) {
+		result = arm_fast_fault(map->pmap, far, fault_type, (fault_code == FSC_ACCESS_FLAG_FAULT_L3), FALSE);
+		if (result == KERN_SUCCESS) {
+			return result;
+		}
+	}
+	kern_return_t kr = vm_fault(map, far, fault_type, FALSE, VM_KERN_MEMORY_NONE, THREAD_UNINT, NULL, 0);
+	if (map != kernel_map) {
+		/* LINUX64 debug: where did the user fault land? */
+		static int reported;
+		if (reported++ < 4) {
+			kprintf("linux64 ufault far 0x%llx esr 0x%llx kr %d map %p pmap %p ttep 0x%llx asid %u phys 0x%llx cur_ttbr0 0x%llx pagesize %llu\n",
+			    far, esr, kr, map, map->pmap, (uint64_t)map->pmap->ttep, (unsigned)map->pmap->hw_asid,
+			    (uint64_t)pmap_find_phys(map->pmap, far) << PAGE_SHIFT, __builtin_arm_rsr64("TTBR0_EL1"),
+			    (uint64_t)vm_map_page_size(map));
+		}
+	}
+	return kr;
+}
+
+/*
+ * LINUX64 (xnulinux): a kernel fault vm_fault could not resolve, taken inside a copyin/copyout routine: the pc its
+ * copyio recovery entry returns through (the routine then returns an error; x0 = EFAULT), 0 when pc has none.
+ */
+uint64_t linux64_kernel_fault_recover(uint64_t pc, uint64_t far, uint64_t esr);
+uint64_t
+linux64_kernel_fault_recover(uint64_t pc, uint64_t far, uint64_t esr)
+{
+	struct copyio_recovery_entry *e = find_copyio_recovery_entry(pc);
+	thread_t thread = current_thread();
+
+	if (e == NULL) {
+		return 0;
+	}
+	if (thread != THREAD_NULL) {
+		thread->machine.recover_esr = esr;
+		thread->machine.recover_far = far;
+	}
+	return (uint64_t)copyio_recover_table + (uint64_t)e->cre_recovery;
+}
+
+/*
+ * LINUX64 (xnulinux): the first return of a new user thread (thread_bootstrap_return) while hosted. The pending ASTs
+ * run as on the way to user space (for the first BSD thread: bsdinit_task, which execs launchd); then the host is told
+ * where user space would start. Entering EL0 is M3.
+ */
+void linux64_thread_bootstrap_return(void) __attribute__((noreturn));
+static thread_t linux64_svc_thread;	/* LINUX64 debug: the thread whose system call is in flight, and its number */
+static long long linux64_svc_num;
+
+void
+linux64_thread_bootstrap_return(void)
+{
+	extern void linux64_stage_arg(unsigned long, unsigned long);
+	thread_t thread = current_thread();
+
+	extern void linux64_el0_run(arm_saved_state_t *) __attribute__((noreturn));
+	static int reported;
+
+	(void)ml_set_interrupts_enabled(FALSE);
+	ast_taken_user();
+	if (linux64_svc_thread == thread) {	/* LINUX64 debug: what the system call returned (C set: x0 is errno) */
+		linux64_svc_thread = NULL;
+		kprintf("linux64: svc %lld -> x0 0x%llx x1 0x%llx%s\n", linux64_svc_num, get_saved_state_reg(thread->machine.upcb, 0),
+		    get_saved_state_reg(thread->machine.upcb, 1), (get_saved_state_cpsr(thread->machine.upcb) & PSR64_C) ? " (error)" : "");
+	}
+	if (reported++ == 0) {
+		linux64_stage_arg(9100, get_saved_state_pc(thread->machine.upcb));
+	}
+	linux64_el0_run(thread->machine.upcb);
+}
+
+/* LINUX64: the registers linux64_el0_vectors saved for an exception taken at EL0 (cswitch.s) */
+struct linux64_el0_frame {
+	uint64_t x[31];
+	uint64_t sp, pc, cpsr, esr, far;
+	uint64_t neon[64];			/* q0..q31 */
+	uint32_t fpsr, fpcr;
+	uint64_t pad;
+};
+_Static_assert(__builtin_offsetof(struct linux64_el0_frame, neon) == 288, "linux64_el0_frame layout");
+_Static_assert(sizeof(struct linux64_el0_frame) == 36 * 8 + 528, "linux64_el0_frame size");
+
+void linux64_el0_exception(struct linux64_el0_frame *f) __attribute__((noreturn));
+void
+linux64_el0_exception(struct linux64_el0_frame *f)
+{
+	thread_t thread = current_thread();
+	arm_saved_state_t *ss = thread->machine.upcb;
+	extern unsigned long linux64_dbg[16];
+
+	linux64_dbg[10]++;			/* LINUX64 debug: EL0 exceptions, the last one's ESR, FAR, PC */
+	linux64_dbg[11] = f->esr;
+	linux64_dbg[12] = f->far;
+	linux64_dbg[13] = f->pc;
+	linux64_dbg[15] = 1;
+	kprintf("linux64: EL0 exception esr 0x%llx far 0x%llx pc 0x%llx x16 %lld ttbr0 0x%llx ttep 0x%llx\n", f->esr, f->far, f->pc, f->x[16],
+	    __builtin_arm_rsr64("TTBR0_EL1"), (uint64_t)thread->map->pmap->ttep);
+	for (unsigned i = 0; i < 29; i++) {
+		set_saved_state_reg(ss, i, f->x[i]);
+	}
+	linux64_dbg[15] = 2;
+	set_saved_state_fp(ss, f->x[29]);
+	set_saved_state_lr(ss, f->x[30]);
+	set_saved_state_sp(ss, f->sp);
+	set_saved_state_pc(ss, f->pc);
+	/* EL0 runs with IRQ/FIQ masked while hosted (no XNU interrupts at EL0 yet); XNU must see the user's own PSTATE,
+	 * or its abort path takes the user fault for one from a non-interruptible context */
+	set_saved_state_cpsr(ss, (uint32_t)f->cpsr & ~(uint32_t)0x3c0);
+	{
+		arm_neon_saved_state_t *ns = thread->machine.uNeon;
+		memcpy(&ns->ns_64.v.q[0], f->neon, sizeof(f->neon));
+		ns->ns_64.fpsr = f->fpsr;
+		ns->ns_64.fpcr = f->fpcr;
+	}
+	linux64_dbg[15] = 3;
+	if (ESR_EC(f->esr) == ESR_EC_SVC_64) {
+		long long num = (long long)f->x[16];
+		linux64_svc_thread = thread;
+		linux64_svc_num = num;
+		if (num == 202 && f->x[1] > 0 && f->x[1] <= 8) {	/* sysctl: the MIB and this thread's kernel stack */
+			int mib[8] = {0};
+			if (copyin((user_addr_t)f->x[0], mib, f->x[1] * sizeof(int)) == 0) {
+				kprintf("linux64: svc 202 mib %d.%d.%d.%d (len %llu) kstack 0x%llx\n", mib[0], mib[1], mib[2], mib[3], f->x[1],
+				    (uint64_t)thread->kernel_stack);
+			}
+		}
+		if (num == 5 || num == 463 || num == 33 || num == 338 || num == 340 || num == 59 || num == 466 || num == 469) {
+			char path[128];
+			size_t len = 0;
+			uint64_t ua = (num == 463 || num == 466 || num == 469) ? f->x[1] : f->x[0];
+			if (copyinstr((user_addr_t)ua, path, sizeof(path), &len) == 0) {
+				kprintf("linux64: svc %lld path \"%s\"\n", num, path);
+			}
+		}
+	}
+	sleh_synchronous(thread->machine.contextData, f->esr, (vm_offset_t)f->far, false);
+	linux64_dbg[15] = 4;
+	thread_exception_return();
+}
