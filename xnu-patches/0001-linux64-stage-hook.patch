@@ -114,7 +115,16 @@ current_thread_volatile(void)
 static inline vm_offset_t
 exception_stack_pointer(void)
 {
-	vm_offset_t result = 0;
+	vm_offset_t result = 0, spsel;
+	/*
+	 * LINUX64 (xnulinux): hosted XNU runs on Linux's SP_EL1 stack, and SP_EL0 is
+	 * Linux's `current`; never flip SPSel. When already on SP_EL1, sp is the answer.
+	 */
+	__asm__ volatile ("mrs %0, SPSel" : "=r" (spsel));
+	if (spsel & 1) {
+		__asm__ volatile ("mov %0, sp" : "=r" (result));
+		return result;
+	}
 	__asm__ volatile (
                  "msr		SPSel, #1  \n"
                  "mov		%0, sp     \n"
