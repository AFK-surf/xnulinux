+ * early_random(). NOT FOR PRODUCTION.
+ */
+extern uint64_t early_random(void);
+static uint64_t linux64_rng_state[2];
+static uint64_t
+linux64_xorshift(uint64_t *st)
+{
+	if (st[0] == 0 && st[1] == 0) {
+		st[0] = early_random() | 1;
+		st[1] = early_random();
+	}
+	uint64_t s1 = st[0], s0 = st[1];
+	st[0] = s0;
+	s1 ^= s1 << 23;
+	st[1] = s1 ^ s0 ^ (s1 >> 17) ^ (s0 >> 26);
+	return st[1] + s0;
+}
+static void
+linux64_fill(uint64_t *st, void *out, size_t len)
+{
+	uint8_t *p = out;
+	while (len) {
+		uint64_t v = linux64_xorshift(st);
+		size_t n = len < sizeof(v) ? len : sizeof(v);
+		memcpy(p, &v, n);
+		p += n;
+		len -= n;
+	}
